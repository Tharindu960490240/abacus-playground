# MongoDB Atlas connection string (Vercel: add the MongoDB Atlas integration, or paste it here)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/mathteacher?retryWrites=true&w=majority

# Long random secret used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Vercel Blob token for profile pictures, tutorial images and course PDFs.
# Created automatically when you add a Blob store to the Vercel project.
# On Vercel itself the store also works without it (the SDK signs in on its own).
BLOB_READ_WRITE_TOKEN=

# Optional: "public" or "private", matching your Blob store. Detected
# automatically on the first upload if left empty.
BLOB_ACCESS=

# Optional: public site URL, used to check the Origin header on form posts.
# Vercel previews are allowed automatically through VERCEL_URL.
APP_URL=http://localhost:3000
